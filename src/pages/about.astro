---
import TopNavbar from "../components/ui/TopNavbar.astro";
import SiteFooter from "../components/ui/SiteFooter.astro";

const education = [
  {
    degree: "Ph.D. in Aerospace Engineering",
    institution: "Iowa State University",
    location: "Ames, Iowa",
    period: "May 2026 – Present",
    detail: "GPA: 3.52 / 4.00",
  },
  {
    degree: "M.S. in Aerospace Engineering, Thesis",
    institution: "Iowa State University",
    location: "Ames, Iowa",
    period: "January 2024 – May 2026",
    detail: "GPA: 3.52 / 4.00",
  },
  {
    degree: "B.Tech. in Mechanical Engineering",
    institution: "Vellore Institute of Technology",
    location: "Vellore, India",
    period: "July 2019 – May 2023",
    detail: "GPA: 7.94 / 10.00",
  },
];

const researchInterests = [
  {
    title: "Space Autonomy, Navigation, and Estimation",
    description:
      "Nonlinear filtering, Bayesian estimation, polynomial Kalman filtering, uncertainty quantification, sigma-point methods, and spacecraft relative navigation.",
    href: "/research#space-estimation",
  },
  {
    title: "Optimal Control",
    description:
      "Stochastic optimal control, covariance steering, risk-sensitive control, nonlinear optimization, and trajectory optimization.",
    href: "/research#optimal-control",
  },
  {
    title: "AI/ML for Engineering Materials",
    description:
      "Machine-learning methods for prediction and characterization of mechanical and wear behavior in engineering materials.",
    href: "/research#materials-ml",
  },
];

const skillGroups = [
  {
    title: "Programming & Scientific Computing",
    skills: [
      "Python",
      "MATLAB",
      "Mathematica",
    ],
  },
  {
    title: "Estimation & Filtering",
    skills: [
      "Kalman Filtering",
      "EKF",
      "UKF",
      "QEKF",
      "QUKF",
      "Polynomial Filtering",
      "Sigma-Point Methods",
      "Conjugate Unscented Transformation",
      "Monte Carlo Analysis",
    ],
  },
  {
    title: "Optimal Control & Optimization",
    skills: [
      "Stochastic Optimal Control",
      "Covariance Steering",
      "Nonlinear Optimization",
      "Trajectory Optimization",
    ],
  },
  {
    title: "Astrodynamics & Navigation",
    skills: [
      "Clohessy-Wiltshire Dynamics",
      "CR3BP",
      "Lambert Problem",
      "Orbit Determination",
      "Spacecraft Relative Navigation",
    ],
  },
  {
    title: "Engineering & Simulation",
    skills: [
      "ABAQUS",
      "ANSYS Fluent",
      "SolidWorks",
      "Autodesk Fusion 360",
      "OpenRocket",
    ],
  },
  {
    title: "Computing Platforms",
    skills: [
      "Google Colab",
      "Jetstream2",
    ],
  },
];

const quickLinks = [
  {
    label: "CV",
    href: "/cv.pdf",
  },
  {
    label: "Resume",
    href: "/resume.pdf",
  },
  {
    label: "LinkedIn",
    href: "https://linkedin.com/in/chiran-cherian",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>About | Chiran Binnu Cherian</title>

    <meta
      name="description"
      content="About Chiran Binnu Cherian, Ph.D. student in Aerospace Engineering at Iowa State University researching spacecraft estimation, optimal control, and machine learning."
    />

    <style>
      html {
        scroll-behavior: smooth;
      }
    </style>
  </head>

  <body class="bg-slate-950 text-white overflow-x-hidden">

    <TopNavbar />
    
    <main>

      <!-- =========================================================
           HERO
      ========================================================== -->
      <section
        class="relative overflow-hidden px-6 py-24 sm:py-28"
      >

        <div class="pointer-events-none absolute inset-0">

          <div
            class="absolute left-1/2 top-1/2
                   h-[650px] w-[650px]
                   -translate-x-1/2 -translate-y-1/2
                   rounded-full bg-cyan-400/5 blur-3xl"
          >
          </div>

          <div
            class="absolute left-1/2 top-1/2
                   h-[430px] w-[430px]
                   -translate-x-1/2 -translate-y-1/2
                   rounded-full border border-white/5"
          >
          </div>

        </div>


        <div
          class="relative mx-auto grid max-w-6xl
                 gap-12 lg:grid-cols-[320px_1fr]
                 lg:items-center"
        >

          <!-- Profile Card -->
          <div
            class="rounded-3xl border border-white/10
                   bg-white/[0.04] p-6 shadow-2xl
                   backdrop-blur"
          >

            <div
              class="overflow-hidden rounded-2xl
                     border border-white/10"
            >
              <img
                src="/profile.jpg"
                alt="Chiran Binnu Cherian"
                class="aspect-square w-full object-cover"
              />
            </div>

            <h2
              class="mt-6 text-2xl font-semibold"
            >
              Chiran Binnu Cherian
            </h2>

            <p
              class="mt-2 text-cyan-300"
            >
              Ph.D. Student in Aerospace Engineering
            </p>

            <p
              class="mt-1 text-sm text-slate-400"
            >
              Iowa State University · Ames, Iowa
            </p>

            <a
              href="mailto:cbckbc@iastate.edu"
              class="mt-4 block text-sm
                     text-slate-300 transition
                     hover:text-cyan-300"
            >
              cbckbc@iastate.edu
            </a>


            <div class="mt-6 flex flex-wrap gap-2">

              {
                quickLinks.map((link) => (
                  <a
                    href={link.href}
                    target={
                      link.href.startsWith("http")
                        ? "_blank"
                        : undefined
                    }
                    rel={
                      link.href.startsWith("http")
                        ? "noopener noreferrer"
                        : undefined
                    }
                    class="rounded-xl border
                           border-white/10 bg-white/5
                           px-3 py-2 text-xs
                           font-medium text-slate-200
                           transition
                           hover:border-cyan-300/30
                           hover:text-cyan-300"
                  >
                    {link.label}
                  </a>
                ))
              }

            </div>

          </div>


          <!-- Intro -->
          <div>

            <p
              class="text-sm uppercase tracking-[0.3em]
                     text-cyan-300/80"
            >
              About
            </p>

            <h1
              class="mt-4 text-4xl font-bold tracking-tight
                     sm:text-5xl lg:text-6xl"
            >
              Researching estimation, control,
              and intelligent engineering systems.
            </h1>

            <p
              class="mt-7 max-w-3xl text-lg
                     leading-8 text-slate-300"
            >
              I am a Ph.D. student in Aerospace Engineering at
              Iowa State University. My research spans spacecraft
              navigation and estimation, nonlinear and higher-order
              filtering, stochastic optimal control, covariance
              steering, and machine-learning applications in
              engineering systems.
            </p>

            <p
              class="mt-5 max-w-3xl leading-8
                     text-slate-400"
            >
              My current work explores estimation methods that move
              beyond conventional linear measurement updates,
              including quadratic and higher-order polynomial
              filtering approaches. I also work on risk-sensitive
              optimal control and covariance steering, while
              maintaining an interdisciplinary interest in
              data-driven modeling of engineering materials.
            </p>


            <div
              class="mt-8 flex flex-wrap gap-3"
            >

              <a
                href="/research"
                class="rounded-xl border
                       border-cyan-300/30
                       bg-cyan-300/5 px-5 py-2.5
                       text-sm font-medium
                       text-cyan-200 transition
                       hover:bg-cyan-300/10"
              >
                Explore Research
              </a>

              <a
                href="/publications"
                class="rounded-xl border
                       border-white/15 bg-white/5
                       px-5 py-2.5 text-sm
                       font-medium text-white
                       transition
                       hover:border-cyan-300/30"
              >
                View Publications
              </a>

            </div>

          </div>

        </div>
      </section>


      <!-- =========================================================
           EDUCATION
      ========================================================== -->
      <section
        class="border-t border-white/10
               bg-slate-900/60 px-6 py-20"
      >

        <div class="mx-auto max-w-6xl">

          <p
            class="text-sm uppercase tracking-[0.3em]
                   text-cyan-300/80"
          >
            Education
          </p>

          <h2
            class="mt-3 text-3xl font-bold"
          >
            Academic background
          </h2>


          <div class="mt-10 space-y-5">

            {
              education.map((item, index) => (
                <article
                  class="grid gap-5 rounded-3xl
                         border border-white/10
                         bg-white/[0.04] p-7
                         md:grid-cols-[70px_1fr_auto]
                         md:items-center"
                >

                  <div
                    class="flex h-12 w-12 items-center
                           justify-center rounded-full
                           border border-cyan-300/30
                           bg-cyan-300/5 text-sm
                           font-semibold text-cyan-300"
                  >
                    {String(index + 1).padStart(2, "0")}
                  </div>


                  <div>

                    <h3
                      class="text-xl font-semibold"
                    >
                      {item.degree}
                    </h3>

                    <p
                      class="mt-2 text-cyan-300/90"
                    >
                      {item.institution}
                    </p>

                    <p
                      class="mt-1 text-sm
                             text-slate-400"
                    >
                      {item.location}
                    </p>

                    <p
                      class="mt-2 text-sm
                             text-slate-400"
                    >
                      {item.detail}
                    </p>

                  </div>


                  <p
                    class="text-sm font-medium
                           text-slate-300 md:text-right"
                  >
                    {item.period}
                  </p>

                </article>
              ))
            }

          </div>

        </div>
      </section>


      <!-- =========================================================
           RESEARCH INTERESTS
      ========================================================== -->
      <section class="px-6 py-20">

        <div class="mx-auto max-w-6xl">

          <p
            class="text-sm uppercase tracking-[0.3em]
                   text-cyan-300/80"
          >
            Research Interests
          </p>

          <h2
            class="mt-3 text-3xl font-bold"
          >
            Areas I am exploring
          </h2>


          <div
            class="mt-10 grid gap-5 lg:grid-cols-3"
          >

            {
              researchInterests.map((area, index) => (
                <a
                  href={area.href}
                  class="group rounded-3xl
                         border border-white/10
                         bg-white/[0.04] p-7
                         transition
                         hover:border-cyan-300/30
                         hover:bg-cyan-300/5"
                >

                  <p
                    class="text-sm font-semibold
                           text-cyan-300"
                  >
                    0{index + 1}
                  </p>

                  <h3
                    class="mt-4 text-xl
                           font-semibold"
                  >
                    {area.title}
                  </h3>

                  <p
                    class="mt-4 leading-7
                           text-slate-400"
                  >
                    {area.description}
                  </p>

                  <p
                    class="mt-6 text-sm
                           font-medium text-cyan-300"
                  >
                    Explore research →
                  </p>

                </a>
              ))
            }

          </div>

        </div>
      </section>


      <!-- =========================================================
           TECHNICAL SKILLS
      ========================================================== -->
      <section
        class="border-t border-white/10
               bg-slate-900/60 px-6 py-20"
      >

        <div class="mx-auto max-w-6xl">

          <p
            class="text-sm uppercase tracking-[0.3em]
                   text-cyan-300/80"
          >
            Technical Skills
          </p>

          <h2
            class="mt-3 text-3xl font-bold"
          >
            Methods and tools
          </h2>


          <div
            class="mt-10 grid gap-5
                   md:grid-cols-2"
          >

            {
              skillGroups.map((group) => (
                <article
                  class="rounded-3xl border
                         border-white/10
                         bg-white/[0.04] p-7"
                >

                  <h3
                    class="text-lg font-semibold
                           text-white"
                  >
                    {group.title}
                  </h3>

                  <div
                    class="mt-5 flex flex-wrap gap-2"
                  >

                    {
                      group.skills.map((skill) => (
                        <span
                          class="rounded-full
                                 border border-white/10
                                 bg-white/5
                                 px-3 py-1.5
                                 text-xs
                                 text-slate-300"
                        >
                          {skill}
                        </span>
                      ))
                    }

                  </div>

                </article>
              ))
            }

          </div>

        </div>
      </section>


      <!-- =========================================================
           PROFESSIONAL OUTLOOK
      ========================================================== -->
      <section class="px-6 py-20">

        <div
          class="mx-auto max-w-5xl
                 rounded-3xl border
                 border-cyan-300/20
                 bg-cyan-300/[0.04]
                 p-8 text-center sm:p-12"
        >

          <p
            class="text-sm uppercase tracking-[0.3em]
                   text-cyan-300/80"
          >
            Looking Ahead
          </p>

          <h2
            class="mt-4 text-3xl font-bold"
          >
            Building across estimation,
            control, and autonomy
          </h2>

          <p
            class="mx-auto mt-6 max-w-3xl
                   leading-8 text-slate-300"
          >
            I am interested in developing rigorous computational
            methods for estimation and control that can operate
            under nonlinear dynamics, uncertainty, and
            non-Gaussian environments, with particular interest
            in aerospace and autonomous systems.
          </p>


          <div
            class="mt-8 flex flex-wrap
                   justify-center gap-3"
          >

            <a
              href="/research"
              class="rounded-xl border
                     border-cyan-300/30
                     px-5 py-2.5 text-sm
                     font-medium text-cyan-200
                     transition
                     hover:bg-cyan-300/10"
            >
              Research
            </a>

            <a
              href="/experience"
              class="rounded-xl border
                     border-white/15
                     bg-white/5 px-5 py-2.5
                     text-sm font-medium
                     text-white transition
                     hover:border-cyan-300/30"
            >
              Experience
            </a>

          </div>

        </div>
      </section>

    </main>

    <SiteFooter />

  </body>
</html>
