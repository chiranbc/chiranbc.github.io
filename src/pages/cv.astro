---
const cvURL = "/cv.pdf";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CV | Chiran Binnu Cherian</title>
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0;url=${cvURL}`} />
    <link rel="canonical" href={new URL(cvURL, Astro.site ?? Astro.url.origin).toString()} />
  </head>
  <body>
    <p>
      Opening the CV. If you are not redirected automatically,
      <a href={cvURL}>view the CV PDF</a>.
    </p>
    <script is:inline define:vars={{ cvURL }}>
      window.location.replace(cvURL);
    </script>
  </body>
</html>
