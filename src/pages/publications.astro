---
import TopNavbar from "../components/ui/TopNavbar.astro";
import SpaceBackdrop from "../components/ui/SpaceBackdrop.astro";
import SiteFooter from "../components/ui/SiteFooter.astro";
import SEO from "../components/ui/SEO.astro";

const peerReviewed = [
  {
    title: "Quadratic Extended and Unscented Kalman Filter Updates",
    authors: "S. Servadio and C. B. Cherian",
    venue:
      "International Conference on Multisensor Fusion and Integration for Intelligent Systems (MFI), 2025",
    type: "Conference Paper",
    researchArea: "Space Autonomy, Navigation, and Estimation",
    description:
      "Introduces quadratic extensions of conventional Kalman-filter measurement updates for nonlinear estimation, incorporating higher-order information beyond affine measurement dependence.",
    links: [],
  },

  {
    title:
      "Machine Learning Based Prediction on Mechanical and Wear Characterization of Sisal Fiber Reinforced Dolomite Dust-Epoxy Hybrid Composites",
    authors:
      "D. Fuloria, C. B. Cherian, S. S. Kumar, S. V. S. Borkar, Y. Manikandan, A. Giri, P. R. Pati, A. Purohit, and G. Gupta",
    venue:
      "Journal of Materials Research and Technology, Vol. 41, pp. 3107–3132, 2026",
    type: "Journal Article",
    researchArea: "AI/ML for Engineering Materials",
    description:
      "Combines experimental characterization of sisal-fiber/dolomite-dust/epoxy hybrid composites with machine-learning methods for predicting mechanical and sliding-wear behavior.",
    links: [
      {
        label: "DOI",
        href: "https://doi.org/10.1016/j.jmrt.2026.01.210",
      },
    ],
  },
];

const underReview = [
  {
    title: "Linear Exponential Quadratic Gaussian Covariance Steering",
    authors: "C. B. Cherian, Y. Isik, and A. Halder",
    venue: "Under Review, 2026",
    type: "Manuscript Under Review",
    researchArea: "Optimal Control",
    description:
      "Studies continuous-time risk-sensitive covariance steering under a Linear Exponential Quadratic Gaussian formulation, including the associated nonlinear matrix equations and numerical solution approach.",
    links: [
      {
        label: "arXiv",
        href: "https://arxiv.org/abs/2609.12463",
      },
    ],
  },

  {
    title: "Polynomial Updates for the Unscented Kalman Filter",
    authors: "C. B. Cherian and S. Servadio",
    venue: "Under Review, 2026",
    type: "Manuscript Under Review",
    researchArea: "Space Autonomy, Navigation, and Estimation",
    description:
      "Extends nonlinear measurement updates to higher-order polynomial estimators while retaining the recursive structure of the Kalman-filter framework.",
    links: [
      {
        label: "arXiv",
        href: "https://arxiv.org/abs/2603.20259",
      },
    ],
  },
];

const allPublications = [...peerReviewed, ...underReview];

const areaCounts = {
  estimation: allPublications.filter(
    (paper) =>
      paper.researchArea ===
      "Space Autonomy, Navigation, and Estimation",
  ).length,

  optimalControl: allPublications.filter(
    (paper) => paper.researchArea === "Optimal Control",
  ).length,

  materials: allPublications.filter(
    (paper) =>
      paper.researchArea === "AI/ML for Engineering Materials",
  ).length,
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title="Publications | Chiran Binnu Cherian"
      description="Peer-reviewed publications and research manuscripts by Chiran Binnu Cherian in spacecraft estimation, optimal control, and machine learning for engineering materials."
    />

    <style>
      html {
        scroll-behavior: smooth;
      }
    </style>
  </head>

  <body class="bg-[#010205] text-white overflow-x-hidden">
    
    <SpaceBackdrop />
<TopNavbar />

    <main id="main-content" class="relative z-10">
      <!-- =========================================================
           HERO
      ========================================================== -->
      <section
        class="relative overflow-hidden px-6 py-24 sm:py-28"
      >

        <div class="pointer-events-none absolute inset-0">

          <div
            class="absolute left-1/2 top-1/2
                   h-[650px] w-[650px]
                   -translate-x-1/2 -translate-y-1/2
                   rounded-full bg-cyan-400/5 blur-3xl"
          >
          </div>

          <div
            class="absolute left-1/2 top-1/2
                   h-[430px] w-[430px]
                   -translate-x-1/2 -translate-y-1/2
                   rounded-full border border-white/5"
          >
          </div>

        </div>


        <div
          class="relative mx-auto max-w-5xl text-center"
        >

          <p
            class="text-sm uppercase tracking-[0.3em]
                   text-cyan-200"
          >
            Publications
          </p>

          <h1
            class="mt-4 text-4xl font-bold tracking-tight
                   sm:text-5xl lg:text-6xl"
          >
            Scholarly Output
          </h1>

          <p
            class="mx-auto mt-6 max-w-3xl
                   text-lg leading-8 text-slate-300"
          >
            Peer-reviewed publications and ongoing manuscripts
            spanning spacecraft navigation and estimation,
            optimal control, and machine learning for engineering
            materials.
          </p>

        </div>

      </section>


      <!-- =========================================================
           QUICK OVERVIEW
      ========================================================== -->
      <section
        class="border-t border-white/10
               bg-black/50 px-6 py-14"
      >
        <div
          class="mx-auto grid max-w-5xl gap-4
                 sm:grid-cols-2 lg:grid-cols-4"
        >

          <div
            class="rounded-2xl border border-white/10
                   bg-white/5 p-5 text-center"
          >
            <p
              class="text-3xl font-bold text-cyan-300"
            >
              {peerReviewed.length}
            </p>

            <p
              class="mt-2 text-sm text-slate-300"
            >
              Peer-Reviewed
            </p>
          </div>


          <div
            class="rounded-2xl border border-white/10
                   bg-white/5 p-5 text-center"
          >
            <p
              class="text-3xl font-bold text-cyan-300"
            >
              {underReview.length}
            </p>

            <p
              class="mt-2 text-sm text-slate-300"
            >
              Under Review
            </p>
          </div>


          <div
            class="rounded-2xl border border-white/10
                   bg-white/5 p-5 text-center"
          >
            <p
              class="text-3xl font-bold text-cyan-300"
            >
              {allPublications.length}
            </p>

            <p
              class="mt-2 text-sm text-slate-300"
            >
              Total Listed
            </p>
          </div>


          <div
            class="rounded-2xl border border-white/10
                   bg-white/5 p-5 text-center"
          >
            <p
              class="text-3xl font-bold text-cyan-300"
            >
              3
            </p>

            <p
              class="mt-2 text-sm text-slate-300"
            >
              Research Areas
            </p>
          </div>

        </div>
      </section>


      <!-- =========================================================
           PEER-REVIEWED PUBLICATIONS
      ========================================================== -->
      <section class="px-6 py-20">

        <div class="mx-auto max-w-6xl">

          <p
            class="text-sm uppercase tracking-[0.3em]
                   text-cyan-200"
          >
            Peer-Reviewed Publications
          </p>

          <h2
            class="mt-3 text-3xl font-bold tracking-tight"
          >
            Published work
          </h2>


          <div class="mt-10 space-y-6">

            {
              peerReviewed.map((paper) => (
                <article
                  class="rounded-3xl border border-white/10
                         bg-white/[0.04] p-7 shadow-xl
                         backdrop-blur sm:p-8"
                >

                  <div
                    class="flex flex-wrap gap-2"
                  >

                    <span
                      class="rounded-full border
                             border-cyan-300/30
                             bg-cyan-300/5 px-3 py-1
                             text-xs font-medium
                             text-cyan-200"
                    >
                      {paper.type}
                    </span>

                    <span
                      class="rounded-full border
                             border-white/10 bg-white/5
                             px-3 py-1 text-xs
                             text-slate-300"
                    >
                      {paper.researchArea}
                    </span>

                  </div>


                  <h3
                    class="mt-5 max-w-4xl text-2xl
                           font-semibold leading-tight"
                  >
                    {paper.title}
                  </h3>


                  <p
                    class="mt-4 text-sm leading-6
                           text-slate-300"
                  >
                    {paper.authors}
                  </p>


                  <p
                    class="mt-2 text-sm font-medium
                           text-cyan-200"
                  >
                    {paper.venue}
                  </p>


                  <p
                    class="mt-5 max-w-4xl leading-8
                           text-slate-300"
                  >
                    {paper.description}
                  </p>


                  {
                    paper.links.length > 0 && (
                      <div
                        class="mt-6 flex flex-wrap gap-3"
                      >
                        {paper.links.map((link) => (
                          <a
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="rounded-xl border
                                   border-cyan-300/30
                                   px-4 py-2 text-sm
                                   font-medium text-cyan-200
                                   transition
                                   hover:bg-cyan-300/10"
                          >
                            {link.label}
                          </a>
                        ))}
                      </div>
                    )
                  }

                </article>
              ))
            }

          </div>

        </div>
      </section>


      <!-- =========================================================
           MANUSCRIPTS UNDER REVIEW
      ========================================================== -->
      <section
        class="border-t border-white/10
               bg-black/50 px-6 py-20"
      >

        <div class="mx-auto max-w-6xl">

          <p
            class="text-sm uppercase tracking-[0.3em]
                   text-cyan-200"
          >
            Manuscripts Under Review
          </p>

          <h2
            class="mt-3 text-3xl font-bold tracking-tight"
          >
            Ongoing scholarly work
          </h2>


          <div class="mt-10 space-y-6">

            {
              underReview.map((paper) => (
                <article
                  class="rounded-3xl border border-white/10
                         bg-white/[0.04] p-7 shadow-xl
                         backdrop-blur sm:p-8"
                >

                  <div class="flex flex-wrap gap-2">

                    <span
                      class="rounded-full border
                             border-cyan-300/30
                             bg-cyan-300/5 px-3 py-1
                             text-xs font-medium
                             text-cyan-200"
                    >
                      {paper.type}
                    </span>

                    <span
                      class="rounded-full border
                             border-white/10 bg-white/5
                             px-3 py-1 text-xs
                             text-slate-300"
                    >
                      {paper.researchArea}
                    </span>

                  </div>


                  <h3
                    class="mt-5 max-w-4xl text-2xl
                           font-semibold leading-tight"
                  >
                    {paper.title}
                  </h3>


                  <p
                    class="mt-4 text-sm leading-6
                           text-slate-300"
                  >
                    {paper.authors}
                  </p>


                  <p
                    class="mt-2 text-sm font-medium
                           text-cyan-200"
                  >
                    {paper.venue}
                  </p>


                  <p
                    class="mt-5 max-w-4xl leading-8
                           text-slate-300"
                  >
                    {paper.description}
                  </p>


                  <div class="mt-6 flex flex-wrap gap-3">

                    {
                      paper.links.map((link) => (
                        <a
                          href={link.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="rounded-xl border
                                 border-cyan-300/30
                                 px-4 py-2 text-sm
                                 font-medium text-cyan-200
                                 transition
                                 hover:bg-cyan-300/10"
                        >
                          {link.label}
                        </a>
                      ))
                    }

                  </div>

                </article>
              ))
            }

          </div>

        </div>
      </section>


      <!-- =========================================================
           RESEARCH-AREA CONNECTION
      ========================================================== -->
      <section class="px-6 py-20">

        <div class="mx-auto max-w-6xl">

          <p
            class="text-sm uppercase tracking-[0.3em]
                   text-cyan-200"
          >
            Research Connections
          </p>

          <h2 class="mt-3 text-3xl font-bold">
            Publications across my research areas
          </h2>


          <div
            class="mt-10 grid gap-5 md:grid-cols-3"
          >

            <!-- Estimation -->
            <a
              href="/research#space-estimation"
              class="group rounded-3xl border
                     border-white/10 bg-white/5
                     p-6 transition
                     hover:border-cyan-300/30
                     hover:bg-cyan-300/5"
            >

              <p
                class="text-3xl font-bold text-cyan-300"
              >
                {areaCounts.estimation}
              </p>

              <h3
                class="mt-4 text-xl font-semibold"
              >
                Space Autonomy, Navigation, and Estimation
              </h3>

              <p
                class="mt-4 leading-7 text-slate-300"
              >
                Higher-order nonlinear filtering,
                polynomial updates, and spacecraft
                estimation applications.
              </p>

              <p
                class="mt-5 text-sm font-medium
                       text-cyan-300"
              >
                Explore research →
              </p>

            </a>


            <!-- Optimal Control -->
            <a
              href="/research#optimal-control"
              class="group rounded-3xl border
                     border-white/10 bg-white/5
                     p-6 transition
                     hover:border-cyan-300/30
                     hover:bg-cyan-300/5"
            >

              <p
                class="text-3xl font-bold text-cyan-300"
              >
                {areaCounts.optimalControl}
              </p>

              <h3
                class="mt-4 text-xl font-semibold"
              >
                Optimal Control
              </h3>

              <p
                class="mt-4 leading-7 text-slate-300"
              >
                Risk-sensitive control, covariance
                steering, and trajectory optimization.
              </p>

              <p
                class="mt-5 text-sm font-medium
                       text-cyan-300"
              >
                Explore research →
              </p>

            </a>


            <!-- Materials -->
            <a
              href="/research#materials-ml"
              class="group rounded-3xl border
                     border-white/10 bg-white/5
                     p-6 transition
                     hover:border-cyan-300/30
                     hover:bg-cyan-300/5"
            >

              <p
                class="text-3xl font-bold text-cyan-300"
              >
                {areaCounts.materials}
              </p>

              <h3
                class="mt-4 text-xl font-semibold"
              >
                AI/ML for Engineering Materials
              </h3>

              <p
                class="mt-4 leading-7 text-slate-300"
              >
                Data-driven prediction and
                characterization of composite-material
                behavior.
              </p>

              <p
                class="mt-5 text-sm font-medium
                       text-cyan-300"
              >
                Explore research →
              </p>

            </a>

          </div>

        </div>
      </section>


      <!-- =========================================================
           EXTERNAL PROFILES
      ========================================================== -->
      <section
        class="border-t border-white/10
               bg-black/50 px-6 py-20"
      >

        <div
          class="mx-auto max-w-5xl text-center"
        >

          <p
            class="text-sm uppercase tracking-[0.3em]
                   text-cyan-200"
          >
            Research Profiles
          </p>

          <h2 class="mt-3 text-3xl font-bold">
            Find my scholarly work
          </h2>

          <p
            class="mx-auto mt-6 max-w-2xl
                   leading-8 text-slate-300"
          >
            Additional publication information,
            citations, and research activity can be
            accessed through my external scholarly
            profiles.
          </p>

          <div
            class="mt-8 flex flex-wrap
                   justify-center gap-3"
          >

            <a
              href="https://scholar.google.com/citations?user=gJAFxi8AAAAJ&hl=en"
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-xl border
                     border-cyan-300/30
                     px-5 py-2.5 text-sm
                     font-medium text-cyan-200
                     transition hover:bg-cyan-300/10"
            >
              Google Scholar
            </a>

            <a
              href="https://www.researchgate.net/profile/Chiran-Cherian?ev=hdr_xprf"
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-xl border
                     border-cyan-300/30
                     px-5 py-2.5 text-sm
                     font-medium text-cyan-200
                     transition hover:bg-cyan-300/10"
            >
              ResearchGate
            </a>

          </div>

        </div>
      </section>
    </main>
    <SiteFooter />

  </body>
</html>
