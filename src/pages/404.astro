---
import TopNavbar from "../components/ui/TopNavbar.astro";
import SiteFooter from "../components/ui/SiteFooter.astro";
import SEO from "../components/ui/SEO.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO
      title="Page Not Found | Chiran Binnu Cherian"
      description="The requested page could not be found on Chiran Binnu Cherian's research website."
      noindex={true}
    />
  </head>

  <body class="bg-slate-950 text-white overflow-x-hidden">
    <TopNavbar />

    <main id="main-content" class="px-6 py-24 sm:py-32">
      <section class="mx-auto max-w-4xl text-center">
        <p class="text-sm uppercase tracking-[0.3em] text-cyan-300/80">
          Navigation Error
        </p>
        <h1 class="mt-5 text-7xl font-bold tracking-tight text-cyan-300 sm:text-8xl">
          404
        </h1>
        <h2 class="mt-5 text-3xl font-bold sm:text-4xl">Page not found</h2>
        <p class="mx-auto mt-6 max-w-2xl leading-8 text-slate-300">
          The page you requested does not exist or may have moved. You can return
          to the homepage or continue exploring the research sections below.
        </p>

        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <a
            href="/"
            class="rounded-xl border border-cyan-300/30 bg-cyan-300/5 px-5 py-2.5 text-sm font-medium text-cyan-200 transition hover:bg-cyan-300/10"
          >
            Return Home
          </a>
          <a
            href="/research"
            class="rounded-xl border border-white/15 bg-white/5 px-5 py-2.5 text-sm font-medium text-white transition hover:border-cyan-300/30"
          >
            Research
          </a>
          <a
            href="/publications"
            class="rounded-xl border border-white/15 bg-white/5 px-5 py-2.5 text-sm font-medium text-white transition hover:border-cyan-300/30"
          >
            Publications
          </a>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
