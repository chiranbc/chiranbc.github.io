---
import TopNavbar from "../components/ui/TopNavbar.astro";
import SiteFooter from "../components/ui/SiteFooter.astro";
import SEO from "../components/ui/SEO.astro";

const recentUpdates = [
  {
    date: "August 2026",
    category: "Research",
    title: "Started Research on LEQG Covariance Steering",
    description:
      "Began research on continuous-time Linear Exponential Quadratic Gaussian covariance steering between prescribed Gaussian endpoint covariances, including risk-sensitive feedback design and numerical solution of the associated nonlinear matrix equations.",
    link: "/research#optimal-control",
    linkLabel: "View research",
  },

  {
    date: "2026",
    category: "Manuscript",
    title: "LEQG Covariance Steering Manuscript Under Review",
    description:
      'The manuscript "Linear Exponential Quadratic Gaussian Covariance Steering," co-authored with Yasemin Isik and Abhishek Halder, is currently under review.',
    link: "https://arxiv.org/abs/2609.12463",
    linkLabel: "View arXiv",
  },

  {
    date: "2026",
    category: "Manuscript",
    title: "Polynomial Kalman Filtering Manuscript Under Review",
    description:
      'The manuscript "Polynomial Updates for the Unscented Kalman Filter," co-authored with Simone Servadio, is currently under review.',
    link: "https://arxiv.org/abs/2603.20259",
    linkLabel: "View arXiv",
  },

  {
    date: "2026",
    category: "Publication",
    title: "Machine Learning and Composite Materials Paper Published",
    description:
      "Published work on machine-learning-based prediction of mechanical and wear characteristics of sisal-fiber reinforced dolomite-dust/epoxy hybrid composites in the Journal of Materials Research and Technology.",
    link: "https://doi.org/10.1016/j.jmrt.2026.01.210",
    linkLabel: "View publication",
  },

  {
    date: "May 2026",
    category: "Academic Milestone",
    title: "Completed M.S. in Aerospace Engineering",
    description:
      "Completed the M.S. in Aerospace Engineering at Iowa State University and continued at Iowa State as a Ph.D. student in Aerospace Engineering.",
    link: "/about",
    linkLabel: "View background",
  },
];

const archiveUpdates = [
  {
    date: "2025",
    category: "Publication",
    title: "Quadratic Kalman Filtering Work Presented at MFI",
    description:
      'Published "Quadratic Extended and Unscented Kalman Filter Updates" with Simone Servadio at the International Conference on Multisensor Fusion and Integration for Intelligent Systems (MFI).',
    link: "/publications",
    linkLabel: "View publications",
  },

  {
    date: "August – December 2025",
    category: "Teaching",
    title: "Teaching Assistant for Graduate Linear Systems",
    description:
      "Served as a Teaching Assistant for AERE / EE / ME / MATH 5770 at Iowa State University, supporting lectures, course presentations, grading, office hours, and student learning.",
    link: "/experience#teaching",
    linkLabel: "View experience",
  },

  {
    date: "May 2025",
    category: "Project",
    title: "Completed Titan Parafoil Terminal-Descent Optimization",
    description:
      "Completed a nonlinear trajectory-optimization study for parafoil terminal descent and soft landing on Titan, incorporating glide-slope, pointing-angle, and virtual-control constraints.",
    link: "/experience#projects",
    linkLabel: "View project",
  },

  {
    date: "December 2024",
    category: "Project",
    title: "Completed Multi-Revolution Lambert Solver Project",
    description:
      "Developed a constrained multiple-revolution Lambert solver and reconstructed interplanetary trajectories including Cassini-Huygens, with validation against NASA/JPL Horizons data.",
    link: "/experience#projects",
    linkLabel: "View project",
  },

  {
    date: "May 2024",
    category: "Research",
    title: "Joined the SPACE Laboratory",
    description:
      "Began graduate research in nonlinear spacecraft estimation at Iowa State University's Spacecraft Procedures for Autonomous Control and Estimation Laboratory.",
    link: "/research#space-estimation",
    linkLabel: "View research",
  },
];

const categoryStyle = {
  Research:
    "border-cyan-300/30 bg-cyan-300/5 text-cyan-200",

  Manuscript:
    "border-violet-300/30 bg-violet-300/5 text-violet-200",

  Publication:
    "border-emerald-300/30 bg-emerald-300/5 text-emerald-200",

  "Academic Milestone":
    "border-amber-300/30 bg-amber-300/5 text-amber-200",

  Teaching:
    "border-sky-300/30 bg-sky-300/5 text-sky-200",

  Project:
    "border-orange-300/30 bg-orange-300/5 text-orange-200",
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <SEO
      title="News | Chiran Binnu Cherian"
      description="Research updates, publications, academic milestones, teaching activities, and professional news from Chiran Binnu Cherian."
    />

    <style>
      html {
        scroll-behavior: smooth;
      }
    </style>
  </head>

  <body class="bg-slate-950 text-white overflow-x-hidden">

    <!-- =========================================================
         NAVIGATION
    ========================================================== -->
    <TopNavbar />


    <main id="main-content">

      <!-- =========================================================
           HERO
      ========================================================== -->
      <section
        class="relative overflow-hidden px-6 py-24 sm:py-28"
      >

        <div class="pointer-events-none absolute inset-0">

          <div
            class="absolute left-1/2 top-1/2
                   h-[650px] w-[650px]
                   -translate-x-1/2 -translate-y-1/2
                   rounded-full bg-cyan-400/5 blur-3xl"
          >
          </div>

          <div
            class="absolute left-1/2 top-1/2
                   h-[430px] w-[430px]
                   -translate-x-1/2 -translate-y-1/2
                   rounded-full border border-white/5"
          >
          </div>

          <div
            class="absolute left-1/2 top-1/2
                   h-[570px] w-[570px]
                   -translate-x-1/2 -translate-y-1/2
                   rounded-full border border-white/5"
          >
          </div>

        </div>


        <div class="relative mx-auto max-w-5xl text-center">

          <p
            class="text-sm uppercase tracking-[0.3em]
                   text-cyan-300/80"
          >
            News
          </p>

          <h1
            class="mt-4 text-4xl font-bold tracking-tight
                   sm:text-5xl lg:text-6xl"
          >
            Mission Log
          </h1>

          <p
            class="mx-auto mt-6 max-w-3xl
                   text-lg leading-8 text-slate-300"
          >
            Selected research developments, publications,
            academic milestones, teaching activities,
            and technical projects.
          </p>

        </div>
      </section>


      <!-- =========================================================
           CURRENT / RECENT UPDATES
      ========================================================== -->
      <section
        class="border-t border-white/10
               bg-slate-900/60 px-6 py-20"
      >

        <div class="mx-auto max-w-6xl">

          <p
            class="text-sm uppercase tracking-[0.3em]
                   text-cyan-300/80"
          >
            Recent Updates
          </p>

          <h2 class="mt-3 text-3xl font-bold">
            Current trajectory
          </h2>


          <div class="relative mt-12">

            <!-- Timeline line -->
            <div
              class="absolute bottom-0 left-[19px]
                     top-0 w-px bg-white/10"
            >
            </div>


            <div class="space-y-8">

              {
                recentUpdates.map((item) => (

                  <article
                    class="relative grid
                           grid-cols-[40px_1fr] gap-5"
                  >

                    <!-- Timeline node -->
                    <div
                      class="relative z-10 mt-2
                             flex h-10 w-10
                             items-center justify-center
                             rounded-full
                             border border-cyan-300/30
                             bg-slate-950"
                    >

                      <div
                        class="h-2.5 w-2.5
                               rounded-full
                               bg-cyan-300"
                      >
                      </div>

                    </div>


                    <!-- Card -->
                    <div
                      class="rounded-3xl
                             border border-white/10
                             bg-white/[0.04]
                             p-7 transition
                             hover:border-cyan-300/20"
                    >

                      <div
                        class="flex flex-wrap
                               items-center gap-3"
                      >

                        <p
                          class="text-sm font-medium
                                 text-cyan-300"
                        >
                          {item.date}
                        </p>

                        <span
                          class:list={[
                            "rounded-full border px-3 py-1 text-xs font-medium",
                            categoryStyle[item.category],
                          ]}
                        >
                          {item.category}
                        </span>

                      </div>


                      <h3
                        class="mt-4 text-2xl
                               font-semibold"
                      >
                        {item.title}
                      </h3>


                      <p
                        class="mt-4 max-w-4xl
                               leading-8
                               text-slate-300"
                      >
                        {item.description}
                      </p>


                      <a
                        href={item.link}
                        target={
                          item.link.startsWith("http")
                            ? "_blank"
                            : undefined
                        }
                        rel={
                          item.link.startsWith("http")
                            ? "noopener noreferrer"
                            : undefined
                        }
                        class="mt-6 inline-block
                               text-sm font-medium
                               text-cyan-300
                               transition
                               hover:text-cyan-200"
                      >
                        {item.linkLabel} →
                      </a>

                    </div>

                  </article>

                ))
              }

            </div>
          </div>

        </div>
      </section>


      <!-- =========================================================
           ARCHIVE
      ========================================================== -->
      <section class="px-6 py-20">

        <div class="mx-auto max-w-6xl">

          <p
            class="text-sm uppercase tracking-[0.3em]
                   text-cyan-300/80"
          >
            Archive
          </p>

          <h2 class="mt-3 text-3xl font-bold">
            Earlier milestones
          </h2>


          <div
            class="mt-10 grid gap-5 md:grid-cols-2"
          >

            {
              archiveUpdates.map((item) => (

                <article
                  class="rounded-3xl
                         border border-white/10
                         bg-white/[0.04]
                         p-7 transition
                         hover:border-cyan-300/20"
                >

                  <div
                    class="flex flex-wrap
                           items-center gap-3"
                  >

                    <p
                      class="text-sm font-medium
                             text-cyan-300"
                    >
                      {item.date}
                    </p>

                    <span
                      class:list={[
                        "rounded-full border px-3 py-1 text-xs font-medium",
                        categoryStyle[item.category],
                      ]}
                    >
                      {item.category}
                    </span>

                  </div>


                  <h3
                    class="mt-4 text-xl
                           font-semibold"
                  >
                    {item.title}
                  </h3>


                  <p
                    class="mt-4 leading-7
                           text-slate-400"
                  >
                    {item.description}
                  </p>


                  <a
                    href={item.link}
                    class="mt-6 inline-block
                           text-sm font-medium
                           text-cyan-300 transition
                           hover:text-cyan-200"
                  >
                    {item.linkLabel} →
                  </a>

                </article>

              ))
            }

          </div>

        </div>
      </section>


      <!-- =========================================================
           LOOKING AHEAD
      ========================================================== -->
      <section
        class="border-t border-white/10
               bg-slate-900/60 px-6 py-20"
      >

        <div
          class="mx-auto max-w-5xl
                 rounded-3xl border
                 border-cyan-300/20
                 bg-cyan-300/[0.04]
                 p-8 text-center sm:p-12"
        >

          <p
            class="text-sm uppercase tracking-[0.3em]
                   text-cyan-300/80"
          >
            Looking Ahead
          </p>

          <h2
            class="mt-4 text-3xl font-bold"
          >
            Continuing the trajectory
          </h2>

          <p
            class="mx-auto mt-6 max-w-3xl
                   leading-8 text-slate-300"
          >
            This page will continue to document new
            publications, research milestones,
            conference activities, presentations,
            awards, and other professional updates.
          </p>


          <div
            class="mt-8 flex flex-wrap
                   justify-center gap-3"
          >

            <a
              href="/research"
              class="rounded-xl border
                     border-cyan-300/30
                     px-5 py-2.5 text-sm
                     font-medium text-cyan-200
                     transition
                     hover:bg-cyan-300/10"
            >
              Research
            </a>

            <a
              href="/publications"
              class="rounded-xl border
                     border-white/15
                     bg-white/5 px-5 py-2.5
                     text-sm font-medium
                     text-white transition
                     hover:border-cyan-300/30"
            >
              Publications
            </a>

          </div>

        </div>

      </section>

    </main>

    <SiteFooter />

  </body>
</html>
