---
const pathname =
  Astro.url.pathname !== "/" && Astro.url.pathname.endsWith("/")
    ? Astro.url.pathname.slice(0, -1)
    : Astro.url.pathname;

const navigation = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Research", href: "/research" },
  { label: "Publications", href: "/publications" },
  { label: "Experience", href: "/experience" },
  { label: "News", href: "/news" },
];

const isActive = (href) => {
  if (href === "/") {
    return pathname === "/";
  }

  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<a
  href="#main-content"
  class="sr-only fixed left-4 top-4 z-[100] rounded-lg bg-cyan-300 px-4 py-2 font-semibold text-slate-950 focus:not-sr-only focus:outline-none focus:ring-2 focus:ring-white"
>
  Skip to main content
</a>

<header
  class="sticky top-0 z-50 border-b border-white/10
         bg-slate-950/90 backdrop-blur-xl"
>
  <nav
    class="mx-auto flex max-w-6xl items-center
           justify-between px-6 py-4"
    aria-label="Primary navigation"
  >

    <!-- Name -->
    <a
      href="/"
      aria-label="Chiran Binnu Cherian home"
      class="text-base font-semibold tracking-wide
             text-white transition
             hover:text-cyan-300 sm:text-lg"
    >
      Chiran Binnu Cherian
    </a>


    <!-- Desktop navigation -->
    <div
      class="hidden items-center gap-6
             text-sm md:flex"
    >
      {
        navigation.map((item) => (
          <a
            href={item.href}
            aria-current={
              isActive(item.href)
                ? "page"
                : undefined
            }
            class:list={[
              "relative py-1 transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300/70 focus-visible:ring-offset-4 focus-visible:ring-offset-slate-950 rounded-sm",
              isActive(item.href)
                ? "font-medium text-cyan-300"
                : "text-slate-300 hover:text-cyan-300",
            ]}
          >
            {item.label}

            {
              isActive(item.href) && (
                <span
                  class="absolute -bottom-1
                         left-1/2 h-px w-5
                         -translate-x-1/2
                         bg-cyan-300"
                  aria-hidden="true"
                />
              )
            }
          </a>
        ))
      }

      <a
        href="/#contact"
        class="rounded-lg border
               border-cyan-300/30
               bg-cyan-300/5
               px-3.5 py-2
               font-medium text-cyan-200
               transition
               hover:bg-cyan-300/10
               focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300/70"
      >
        Contact
      </a>
    </div>


    <!-- Mobile menu -->
    <details class="group relative md:hidden">

      <summary
        class="flex cursor-pointer list-none
               items-center justify-center
               rounded-lg border border-white/10
               bg-white/5 p-2.5
               text-slate-200 transition
               hover:border-cyan-300/30
               hover:text-cyan-300"
        aria-label="Navigation menu"
      >

        <!-- Hamburger -->
        <svg
          class="h-5 w-5 group-open:hidden"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.8"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>

        <!-- Close -->
        <svg
          class="hidden h-5 w-5 group-open:block"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.8"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18 18 6M6 6l12 12"
          />
        </svg>

      </summary>


      <div
        class="absolute right-0 top-[calc(100%+0.75rem)]
               w-64 overflow-hidden rounded-2xl
               border border-white/10
               bg-slate-950/95 p-2
               shadow-2xl backdrop-blur-xl"
      >

        {
          navigation.map((item) => (
            <a
              href={item.href}
              aria-current={
                isActive(item.href)
                  ? "page"
                  : undefined
              }
              class:list={[
                "block rounded-xl px-4 py-3 text-sm transition",
                isActive(item.href)
                  ? "bg-cyan-300/10 font-medium text-cyan-300"
                  : "text-slate-300 hover:bg-white/5 hover:text-cyan-300",
              ]}
            >
              {item.label}
            </a>
          ))
        }

        <div class="my-2 border-t border-white/10"></div>

        <a
          href="/#contact"
          class="block rounded-xl
                 px-4 py-3 text-sm
                 font-medium text-cyan-200
                 transition hover:bg-cyan-300/10"
        >
          Contact
        </a>

      </div>

    </details>

  </nav>
</header>

<style is:global>
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto !important;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
